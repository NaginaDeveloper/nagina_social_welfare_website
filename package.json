{
  "name": "nagina-social-welfare-website",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/fetch-latest-videos.mjs && node scripts/fetch-campuses.mjs && ng build && node --experimental-strip-types scripts/generate-route-html.mjs",
    "videos:latest": "node scripts/fetch-latest-videos.mjs",
    "assistant:ingest": "node scripts/ingest-assistant-knowledge.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "campuses:snapshot": "node scripts/fetch-campuses.mjs",
    "deploy": "npm run build && node scripts/deploy-gh-pages.mjs"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "firebase": "^11.10.0",
    "libphonenumber-js": "^1.13.12",
    "pdf-parse": "^2.4.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "@angular/platform-server": "22.2.2",
    "@angular/ssr": "22.2.2"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@tailwindcss/postcss": "^4.3.2",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.19",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
