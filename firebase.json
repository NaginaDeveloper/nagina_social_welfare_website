{
  "functions": [
    {
      "source": "functions",
      "codebase": "donations",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "nagina-donations",
    "public": "hosting-api",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/createDonationCheckout",
        "function": {
          "functionId": "createDonationCheckout",
          "region": "europe-west2"
        }
      },
      {
        "source": "/sumupWebhook",
        "function": {
          "functionId": "sumupWebhook",
          "region": "europe-west2"
        }
      },
      {
        "source": "/askNaginaAssistant",
        "function": {
          "functionId": "askNaginaAssistant",
          "region": "europe-west2"
        }
      },
      {
        "source": "/syncAssistantKnowledge",
        "function": {
          "functionId": "syncAssistantKnowledge",
          "region": "europe-west2"
        }
      }
    ]
  }
}
